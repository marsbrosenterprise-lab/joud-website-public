---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { productCategories } from '../data/products';
import '../styles/global.css';
---
<SiteLayout title="Premium Dates & Dry Fruits" description="JOUD brings thoughtfully chosen dates and dry fruits to your table, with a focus on quality, heritage and beautiful gifting.">
  <Header />
  <main>
    <section class="hero">
      <div class="hero-copy"><span class="eyebrow">Dates · dry fruits · gifting</span><h1>Good things,<br />chosen well.</h1><p>Premium dates and dry fruits with a point of view — selected with care, prepared for sharing, and made to be remembered.</p><a class="button" href="#products">Explore the collection ↗</a></div>
    </section>
    <section class="section" id="about"><div class="split"><div><span class="eyebrow">Our story</span><h2>Rooted in tradition, chosen with care.</h2><p>JOUD began with a simple idea: dates and dry fruits deserve the same attention as any fine food. Every batch is chosen with intention and brought to your table with the taste and heritage it deserves.</p><a class="text-link" href="#products">Discover JOUD ↗</a></div><img class="about-image" src="/images/about_img.jpg" alt="JOUD dates and dry fruits arrangement" loading="lazy" decoding="async" /></div></section>
    <section class="section section-dark" id="products"><div class="section-heading"><span class="eyebrow">The collection</span><h2>What we bring to your table.</h2><p>A considered range for everyday rituals, generous gifting and special occasions. Reach out on WhatsApp for current availability and custom assortments.</p></div><div class="product-grid">{productCategories.map((product) => <ProductCard product={product} />)}</div></section>
    <section class="section enquire" id="enquire"><span class="eyebrow">Personalised help</span><h2>Need help choosing?</h2><p>Tell us the occasion. We’ll curate the right sweetness for it.</p><a class="button" href="https://wa.me/919894938496?text=Hi%2C%20I%27d%20like%20help%20choosing%20from%20JOUD." target="_blank" rel="noopener">Speak to JOUD ↗</a></section>
  </main>
  <Footer />
</SiteLayout>
