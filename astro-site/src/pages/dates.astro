---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<SiteLayout title="Dates Collection" description="Explore the JOUD collection of premium dates, selected for flavour, texture and gifting.">
  <Header />
  <main>
    <section class="hero"><div class="hero-copy"><span class="eyebrow">The dates collection</span><h1>Every variety<br />has a moment.</h1><p>Discover dates selected for their character — from soft, generous bites to deep, caramel-rich favourites.</p></div></section>
    <section class="section"><div class="section-heading"><span class="eyebrow">A closer look</span><h2>Choose your kind of sweet.</h2><p>Product detail pages, tasting notes, pack sizes and availability will live here as the collection grows.</p></div><div class="product-grid"><article class="product-card"><img src="/images/cat_dates.jpg" alt="Premium dates" /><div class="product-copy"><span class="eyebrow">Signature</span><h3>Dates, thoughtfully chosen</h3><p>Speak with JOUD for current varieties and curated assortments.</p><a class="text-link" href="https://wa.me/919894938496?text=Hi%2C%20I%27m%20interested%20in%20the%20JOUD%20Dates%20Collection." target="_blank" rel="noopener">Enquire ↗</a></div></article></div></section>
  </main>
  <Footer />
</SiteLayout>
