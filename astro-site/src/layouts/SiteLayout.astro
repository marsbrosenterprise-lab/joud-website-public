---
export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/hero_gift.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="JOUD For Dates &amp; Dry Fruits" />
    <meta name="theme-color" content="#1C1814" />
    <link rel="icon" type="image/png" href="/images/logo_icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={`${title} — JOUD premium dates and dry fruits`} />
    <meta property="og:site_name" content="JOUD For Dates &amp; Dry Fruits" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | JOUD`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': 'https://joudtraders.com/#organization',
      name: 'JOUD For Dates & Dry Fruits',
      alternateName: 'JOUD',
      url: 'https://joudtraders.com/',
      logo: 'https://joudtraders.com/images/logo_wordmark.png',
      image: 'https://joudtraders.com/images/hero_gift.jpg',
      telephone: '+91 98949 38496',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '150/105C/11, Haji Appa Street',
        addressLocality: 'Kayalpatnam',
        postalCode: '628204',
        addressCountry: 'IN'
      },
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'JOUD For Dates & Dry Fruits',
      url: 'https://joudtraders.com/',
      telephone: '+919894938496',
      areaServed: { '@type': 'Country', name: 'India' },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '150/105C/11, Haji Appa Street',
        addressLocality: 'Kayalpatnam',
        addressRegion: 'Tamil Nadu',
        postalCode: '628204',
        addressCountry: 'IN'
      }
    })}></script>
    <title>{title} | JOUD</title>
  </head>
  <body>
    <slot />
  </body>
</html>
